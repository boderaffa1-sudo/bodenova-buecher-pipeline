# ═══════════════════════════════════════════════════════════════════
# Bodenova Books Worker — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Für Railway: als Variables im Projekt setzen
# Lokal: als .env kopieren

# ─── Railway ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Airtable ───────────────────────────────────────────────────────
AIRTABLE_PAT=patAf...             # Personal Access Token
AIRTABLE_BASE_ID=appWh8CQNQbpI1tLJ
AIRTABLE_TABLE_INVENTORY=tblxHGAquMrRoUn5p    # Inventory Items
AIRTABLE_TABLE_PHOTO_QUEUE=tblSENLJuXV5Nd8O9  # Photo_Queue
AIRTABLE_TABLE_BOOKS=tblEzZCBcwpPJmEl7        # Books (Legacy, wird abgelöst)

# ─── Google Drive ───────────────────────────────────────────────────
# Service-Account JSON (base64-encoded) — ODER OAuth-Token
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_DRIVE_FOLDER_ID=1Oq9I55IinW-Q1AAekcnDfvwAt_IIf8Rd

# ─── OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_DETAIL=low

# ─── Booklooker ─────────────────────────────────────────────────────
BOOKLOOKER_API_KEY=

# ─── AbeBooks ───────────────────────────────────────────────────────
ABEBOOKS_BOOKSELLER_ID=89785814
ABEBOOKS_EMAIL_TO=bode@bodenova.de

# ─── eBay ───────────────────────────────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_SANDBOX=false

# ─── Salvante (Supabase) ────────────────────────────────────────────
SUPABASE_URL=https://ztnkvtagnefygvixshqu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Resend (für Mails / AbeBooks CSV / Alerts) ─────────────────────
RESEND_API_KEY=
NOTIFY_EMAIL=bode@bodenova.de
FROM_EMAIL=Bodenova <noreply@bodenova.de>

# ─── Telegram (für Alerts) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Worker-Config ──────────────────────────────────────────────────
VISION_BATCH_SIZE=20              # 20 Fotos pro Vision-Run (Railway hat viel Memory)
VISION_CONCURRENCY=5              # Parallel-Calls zu OpenAI
CONSOLIDATOR_INTERVAL_MIN=15
PRICING_INTERVAL_HOURS=2
LISTING_INTERVAL_MIN=30
CROSS_DELIST_INTERVAL_MIN=15

# ─── Fail-Safes ─────────────────────────────────────────────────────
MAX_CRASH_LOOPS=3                 # Nach 3 gleichen Fehlern: Worker pausiert
MAX_RETRIES_PER_PHOTO=3           # Nach 3 Fehlversuchen: Foto → Manual_Review
DAILY_OPENAI_BUDGET_USD=5.00      # Bei Überschreitung: Alert
